# Optional. Copy to .env; Node 22 and Vite load it.
HOST=127.0.0.1
PORT=3001
INPUT_DELAY_TICKS=6
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Production LAN uses the current browser origin through Apache. No frontend
# server URL is needed. iniciar-multiplayer.bat always binds loopback only.
